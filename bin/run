#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
case "${1:-}" in test|check|pack|testbed-preview) task="$1" ;; *) echo 'Usage: bin/run {test|check|pack|testbed-preview}' >&2; exit 2 ;; esac
mkdir -p "$root/artifacts"
ports=()
if [[ "$task" == testbed-preview ]]; then
  ports=(--publish 127.0.0.1:4173:4173 --name "${AUR_TESTBED_CONTAINER:-aur-testbed-preview-$$}")
fi
docker run --rm --init --user "$(id -u):$(id -g)" \
  "${ports[@]}" \
  --env HOME=/tmp --env NG_CLI_ANALYTICS=false --env "AUR_TASK=$task" \
  --mount "type=bind,src=$root,dst=/source,readonly" \
  --mount "type=bind,src=$root/artifacts,dst=/artifacts" \
  node:24.22.2-bookworm-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9 \
  sh -eu -c '
    mkdir /tmp/workspace
    cp /source/package*.json /source/angular.json /source/tsconfig.json /source/README.md /source/LICENSE /source/NOTICE /tmp/workspace/
    cp -R /source/projects /source/scripts /source/tests /source/docs /source/apps /tmp/workspace/
    cd /tmp/workspace
    npm ci --no-audit --no-fund
    npm run "$AUR_TASK"
  '
if [[ "$task" == check ]]; then
  docker run --rm --init --platform linux/amd64 --shm-size=1g --user "$(id -u):$(id -g)" \
    --env HOME=/tmp --env PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    --mount "type=bind,src=$root/tests/browser,dst=/fixture,readonly" \
    --mount "type=bind,src=$root/artifacts,dst=/artifacts" \
    mcr.microsoft.com/playwright:v1.58.2-noble@sha256:65cefd09a5e943921ecd3a6e5414c603db2eb161e9eb48f2e2ccc63486dc7dc0 \
    sh -eu -c '
      mkdir /tmp/browser
      cp -R /fixture/. /tmp/browser/
      cd /tmp/browser
      npm ci --no-audit --no-fund
      ./node_modules/.bin/playwright test
    '
fi
