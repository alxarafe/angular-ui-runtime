{
  "manifestVersion": 1,
  "package": "@alxarafe/ui-theme-alternative",
  "version": "0.1.0-alpha.3",
  "publisher": "Alxarafe contributors",
  "license": "Apache-2.0",
  "compatibility": {
    "angular": "^22.0.0",
    "uiRuntime": "0.3.0-alpha.3",
    "requiredCapabilities": [
      "ThemeShellOutlet",
      "ThemeNavigationOutlet",
      "ThemePanelOutlet"
    ]
  },
  "themes": [
    {
      "id": "alternative",
      "name": "Alternative",
      "description": "Optional alternative presentation adapted from ERBAS",
      "cssClass": "theme-alternative",
      "definitionExport": "ALTERNATIVE_THEME",
      "kinds": [
        "partial"
      ],
      "artifacts": [
        "field.BOOLEAN"
      ],
      "requiredCapabilities": [
        "structural-composition-ports-v1"
      ]
    }
  ],
  "styles": [
    "./theme.css"
  ],
  "assets": [],
  "evidence": "./conformance.json",
  "distribution": "private prerelease; publication prohibited"
}
